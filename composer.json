{
    "name": "votre-nom/facturation-php",
    "description": "Application de facturation PHP — TP CI/CD",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "lint": "php-cs-fixer check src/ tests/ --diff",
        "lint:fix": "php-cs-fixer fix src/ tests/",
        "stan": "phpstan analyse src/ --level=5",
        "qa": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}